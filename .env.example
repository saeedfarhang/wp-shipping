# -----------------------------------------------------------------------------
# WordPress infrastructure — copy to .env and fill in real values.
#   cp .env.example .env
#   chmod 600 .env
# Never commit .env.
# -----------------------------------------------------------------------------

# Compose project name. Keeps named volumes stable across deploy paths.
PROJECT_NAME=wordpress

# VPS address used for health checks and documented public URLs.
# Use the host's reachable IP (or 127.0.0.1 for local-only checks).
VPS_IP=127.0.0.1

# Host ports published by Nginx. Do not change without updating the firewall.
PROD_PORT=8080
STAGE_PORT=8081

# Optional public URLs (used by staging sync search-replace).
# Defaults to http://${VPS_IP}:${PROD_PORT} and http://${VPS_IP}:${STAGE_PORT}.
# PROD_PUBLIC_URL=http://203.0.113.10:8080
# STAGE_PUBLIC_URL=http://203.0.113.10:8081

# -----------------------------------------------------------------------------
# Pinned image versions — bump intentionally, deploy staging first.
# See docs/operations.md.
# -----------------------------------------------------------------------------
WORDPRESS_IMAGE=wordpress:6.8-php8.3-fpm
WORDPRESS_TAG=6.8-php8.3-fpm
NGINX_IMAGE=nginx:1.26-alpine
MARIADB_IMAGE=mariadb:11.4
REDIS_IMAGE=redis:7.4-alpine
AWS_CLI_IMAGE=amazon/aws-cli:2.17.54

# -----------------------------------------------------------------------------
# MariaDB — root is for operators/backups only. App users are isolated.
# Initialization runs ONLY on first volume create. See docs/architecture.md.
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password

PROD_DB_NAME=wordpress_prod
PROD_DB_USER=wordpress_prod_user
PROD_DB_PASSWORD=change-me-prod-db-password

STAGE_DB_NAME=wordpress_stage
STAGE_DB_USER=wordpress_stage_user
STAGE_DB_PASSWORD=change-me-stage-db-password

# Conservative default for smaller hosts. On 16 GB RAM, 2G–3G is reasonable.
MARIADB_INNODB_BUFFER_POOL_SIZE=512M
MARIADB_MAX_CONNECTIONS=150

# -----------------------------------------------------------------------------
# Redis — object cache only. Separate instances and passwords.
# -----------------------------------------------------------------------------
REDIS_PROD_PASSWORD=change-me-redis-prod-password
REDIS_STAGE_PASSWORD=change-me-redis-stage-password
REDIS_PROD_MAXMEMORY=256mb
REDIS_STAGE_MAXMEMORY=128mb

# -----------------------------------------------------------------------------
# PHP / WordPress
# WORDPRESS_*_MEMORY_LIMIT is the PHP memory_limit (not the container cap).
# -----------------------------------------------------------------------------
TZ=UTC
WORDPRESS_PROD_MEMORY_LIMIT=256M
WORDPRESS_STAGE_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=120

# -----------------------------------------------------------------------------
# Container resource limits (cgroup). Staging is capped below production
# so a runaway staging site cannot exhaust the VPS.
#
# Planning for 8 vCPU / 16 GB (see docs/architecture.md):
#   wordpress-prod  2 CPU / 4G
#   wordpress-stage 1 CPU / 2G
#   mariadb         2 CPU / 4G
#   redis-prod      0.50 CPU / 1G
#   redis-stage     0.25 CPU / 512M
#   nginx-*         0.25–0.50 CPU / 128M
# -----------------------------------------------------------------------------
WORDPRESS_PROD_CPU_LIMIT=2.0
WORDPRESS_PROD_MEM_LIMIT=4G
WORDPRESS_PROD_MEM_RESERVATION=1G

WORDPRESS_STAGE_CPU_LIMIT=1.0
WORDPRESS_STAGE_MEM_LIMIT=2G
WORDPRESS_STAGE_MEM_RESERVATION=512M

MARIADB_CPU_LIMIT=2.0
MARIADB_MEM_LIMIT=4G
MARIADB_MEM_RESERVATION=1G

REDIS_PROD_CPU_LIMIT=0.50
REDIS_PROD_MEM_LIMIT=1G
REDIS_PROD_MEM_RESERVATION=128M

REDIS_STAGE_CPU_LIMIT=0.25
REDIS_STAGE_MEM_LIMIT=512M
REDIS_STAGE_MEM_RESERVATION=64M

NGINX_PROD_CPU_LIMIT=0.50
NGINX_PROD_MEM_LIMIT=128M
NGINX_STAGE_CPU_LIMIT=0.25
NGINX_STAGE_MEM_LIMIT=128M

# -----------------------------------------------------------------------------
# S3-compatible backups (optional but required for off-box copies).
# Leave S3_BUCKET empty to keep backups local-only (not recommended).
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=wordpress-infra

# Local backup retention in days. Remote retention should be an S3 lifecycle rule.
BACKUP_LOCAL_RETENTION_DAYS=7

# Optional AES-256 encryption before S3 upload (openssl enc). Leave empty to disable.
# BACKUP_ENCRYPTION_KEY=

# Canonical deploy path used by GitLab CI (shell runner).
DEPLOY_DIR=/opt/wordpress-infra
