# Secrets and local environment
.env
.env.*
!.env.example

# Runtime data
backups/*
!backups/.gitkeep
*.sql
*.sql.gz
*.tar
*.tar.gz

# WordPress runtime at the repo root only (must live in Docker volumes).
# Do not use a bare "wordpress/" pattern — that also ignored docker/wordpress.
/wp-content/
/wordpress/

# Certificates / keys (not used by default; keep ignored)
*.pem
*.key
*.crt
!docker/**/*.conf

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.log

# Docker
.docker-cache/
